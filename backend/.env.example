# Twilio (trial account: https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Deepgram (https://console.deepgram.com) — $200 free credit
DEEPGRAM_API_KEY=your_deepgram_key

# Grok / xAI (https://console.x.ai — preferred LLM provider)
GROK_API_KEY=your_grok_key

# Kimi (https://www.kimi.com/code — console → API Keys; OpenAI-compatible API)
# Used as fallback when GROK_API_KEY is unset
KIMI_API_KEY=your_kimi_key

# Cartesia (https://play.cartesia.ai) — free tier
CARTESIA_API_KEY=your_cartesia_key

# ElevenLabs (https://elevenlabs.io) — free tier
ELEVENLABS_API_KEY=your_elevenlabs_key

# Public URL of THIS backend (ngrok URL locally, Railway domain in prod).
# Used to build the Twilio webhook + media stream URLs for outbound calls.
PUBLIC_URL=https://your-backend.up.railway.app

# Frontend origin for CORS (Vercel URL in prod)
FRONTEND_URL=http://localhost:3000

# SQLite database file
DATABASE_PATH=voiceflow.db

# App switch: True = fully usable. False = demo-notice mode (calling disabled,
# dashboard shows "demo app, not for commercial use").
APP_ACTIVE=True

# Human handoff: number to transfer escalated calls to (E.164, Twilio-verified)
HUMAN_HANDOFF_NUMBER=+91xxxxxxxxxx
